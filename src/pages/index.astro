---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<BaseLayout title="AkroSecure — Engineering Security. Building Trust.">
  <main id="top">

      <!-- HERO -->
      <div class="hero">
        <div class="wrap hero-grid">
          <div>
            <div class="kicker">Cybersecurity Advisory · Engineering · Assurance</div>
            <h1>Engineering Security.<br /><span class="hl">Building Trust.</span></h1>
            <p class="value">Understand your risks. Strengthen your defenses. Build with confidence.</p>
            <p class="lede">AkroSecure is an emerging cybersecurity advisory, engineering and assurance practice. We help organisations see their security posture clearly, prioritise what matters, and build products and systems that can withstand scrutiny — from regulators, auditors, customers and attackers.</p>
            <div class="ctas">
              <a class="btn" href="#contact">Request a consultation</a>
              <a class="btn ghost" href="#services">Explore services</a>
            </div>
            <p class="status-note">Now forming founding engagements. Service availability is marked honestly on every offering below — no inflated claims, no borrowed track record.</p>
          </div>
          <div class="approach-panel" aria-label="Our approach at a glance">
            <h2>OUR APPROACH</h2>
            <ol>
              <li><strong>Assess</strong>Establish where you stand — posture, risks, gaps against the standards you answer to.</li>
              <li><strong>Prioritise</strong>Rank findings by real-world risk and business impact, not by checklist volume.</li>
              <li><strong>Strengthen</strong>Engineer the fixes: architecture, controls, policies and product security.</li>
              <li><strong>Validate</strong>Test, evidence and prepare — so assurance holds up under audit and attack alike.</li>
            </ol>
          </div>
        </div>
      </div>

      <div class="domains" aria-label="Areas of practice">
        <div class="wrap">
          <span>Security Posture Assessments</span><span>ISO 27001 Readiness</span><span>SOC 2 Readiness</span><span>NIST CSF</span><span>EU CRA Readiness</span><span>PKI &amp; Cryptography</span><span>TLS / mTLS</span><span>Product Security</span>
        </div>
      </div>

      <!-- SERVICES -->
      <section class="block" id="services">
        <div class="wrap">
          <div class="sec-head">
            <div class="kicker">Services</div>
            <h2>Four practices, one standard of rigour</h2>
            <p>Advisory that ends in engineering, and engineering that ends in evidence. Each practice is scoped to a defined outcome — and labelled by its current availability, so you always know what is on offer today versus what is being built.</p>
          </div>
          <div class="services">
            <article class="service">
              <div class="top"><span class="svc-num">01</span><span class="badge now">Accepting inquiries</span></div>
              <h3>Cybersecurity Strategy &amp; Advisory</h3>
              <p class="for">For leadership teams who need a clear-eyed view of risk and a plan they can fund, sequence and defend.</p>
              <ul>
                <li>Security posture assessments — where you stand, evidenced</li>
                <li>Cybersecurity roadmaps — phased, costed, tied to risk</li>
                <li>Risk assessments — assets, threats, likelihood, impact</li>
                <li>Security strategy aligned to business objectives</li>
                <li>Board- and executive-ready reporting on security risk</li>
              </ul>
              <div class="outcome"><strong>Outcome:</strong> a prioritised, fundable plan — not a shelf of findings.</div>
            </article>
            <article class="service">
              <div class="top"><span class="svc-num">02</span><span class="badge now">Accepting inquiries</span></div>
              <h3>Governance, Risk &amp; Compliance</h3>
              <p class="for">For organisations preparing for certification, audit, or customer security scrutiny — and wanting the work to improve security, not just paperwork.</p>
              <ul>
                <li>ISO 27001 readiness — gap analysis, ISMS design, evidence preparation</li>
                <li>SOC 2 readiness — controls design and audit preparation</li>
                <li>NIST Cybersecurity Framework alignment and maturity assessment</li>
                <li>Security policies, standards and control frameworks</li>
                <li>Audit preparation and security assurance support</li>
              </ul>
              <div class="outcome"><strong>Outcome:</strong> controls that are real, evidenced, and ready to be examined.</div>
            </article>
            <article class="service">
              <div class="top"><span class="svc-num">03</span><span class="badge now">Accepting inquiries</span></div>
              <h3>Product Security &amp; Engineering</h3>
              <p class="for">For product and platform teams building connected, regulated, or trust-critical systems — including those facing EU Cyber Resilience Act obligations.</p>
              <ul>
                <li>EU CRA readiness — product classification, essential requirements, evidence</li>
                <li>Secure architecture and design review</li>
                <li>Product security — threat modelling, secure development practices</li>
                <li>PKI design and certificate lifecycle management</li>
                <li>Cryptography, TLS / mTLS — correct configuration, honestly assessed</li>
              </ul>
              <div class="outcome"><strong>Outcome:</strong> products engineered to be secure — and able to prove it.</div>
            </article>
            <article class="service">
              <div class="top"><span class="svc-num">04</span><span class="badge dev">In development</span></div>
              <h3>Cybersecurity Training &amp; Capability Development</h3>
              <p class="for">For teams who need lasting capability, not one-off awareness — practitioner-led training grounded in real architecture and assurance work.</p>
              <ul>
                <li>Security architecture training — Foundation to Advanced</li>
                <li>Hands-on labs and live design-review demonstrations</li>
                <li>Team capability assessments and learning roadmaps</li>
                <li>Exam and interview preparation for security professionals</li>
                <li>Verifiable certificates for completed, assessed courses</li>
              </ul>
              <div class="outcome"><strong>Outcome:</strong> people who can do the work after the engagement ends.</div>
              <p style="margin-top:14px;"><a href="/training/" style="font-weight:700;">See the course catalogue →</a></p>
            </article>
          </div>
          <div class="note-box"><strong>A note on readiness work:</strong> AkroSecure prepares organisations for ISO 27001 certification and SOC 2 attestation — gap analysis, controls, evidence and audit preparation. Certification itself is issued only by accredited certification bodies, and SOC 2 reports only by licensed CPA firms. We do not issue either, and no readiness engagement can guarantee an audit or certification outcome. What we guarantee is honest assessment and work that stands up to examination.</div>
        </div>
      </section>

      <!-- WHO WE HELP -->
      <section class="block" id="who">
        <div class="wrap">
          <div class="sec-head">
            <div class="kicker">Who we help</div>
            <h2>Built for organisations at a decision point</h2>
            <p>Most engagements start with a trigger: a regulation arriving, an audit on the calendar, a customer asking hard questions, or a product about to ship. If one of these sounds familiar, the conversation is worth having.</p>
          </div>
          <div class="help-grid">
            <div class="help-card">
              <h3>Organisations pursuing ISO 27001 or SOC 2</h3>
              <p>You need certification or attestation for growth — a market requirement, an enterprise customer, a tender. We build the management system and the evidence properly, so readiness is real rather than theatrical.</p>
            </div>
            <div class="help-card">
              <h3>Product companies facing the EU CRA</h3>
              <p>You sell products with digital elements into Europe and need to understand classification, essential cybersecurity requirements, vulnerability handling and conformity evidence — before deadlines force rushed work.</p>
            </div>
            <div class="help-card">
              <h3>Leaders who need a defensible roadmap</h3>
              <p>You know security needs investment but not where it counts most. A posture assessment and risk-ranked roadmap turns a vague concern into a sequenced, budgeted programme the board can approve.</p>
            </div>
            <div class="help-card">
              <h3>Engineering teams with hard problems</h3>
              <p>PKI that has grown organically, mTLS rolled out unevenly, cryptography chosen by default. We review, design and help implement identity and encryption architecture that is correct — and operable.</p>
            </div>
          </div>
          <div class="notfit">
            <h3>An honest note on fit</h3>
            <p>AkroSecure is an emerging practice, deliberately selective about engagements. We are not a staffing agency, a reseller, or a penetration-testing firm, and we will say so — and point you elsewhere — when a request sits outside advisory, engineering and assurance. We would rather decline work than oversell capability.</p>
          </div>
        </div>
      </section>

      <!-- APPROACH -->
      <section class="block" id="approach">
        <div class="wrap">
          <div class="sec-head">
            <div class="kicker">Our approach</div>
            <h2>Assess → Prioritise → Strengthen → Validate</h2>
            <p>Every engagement follows the same discipline, whether it is a two-week posture assessment or a year-long readiness programme. You always know which stage you are in, what it produces, and what comes next.</p>
          </div>
          <div class="steps4">
            <div class="step4"><div class="n">1</div><h3>Assess</h3><p>Establish the facts: current posture, architecture, controls, and gaps against the frameworks and regulations you answer to — ISO 27001, SOC 2 criteria, NIST CSF, EU CRA.</p><p class="out"><strong>Produces:</strong> an evidenced assessment, not an opinion.</p></div>
            <div class="step4"><div class="n">2</div><h3>Prioritise</h3><p>Rank what we found by exploitability, business impact and regulatory exposure. Agree the sequence with you — what must happen now, what can be planned, what can be consciously accepted.</p><p class="out"><strong>Produces:</strong> a risk-ranked roadmap with owners and dates.</p></div>
            <div class="step4"><div class="n">3</div><h3>Strengthen</h3><p>Do the engineering: secure architecture, PKI and TLS design, policies and controls, product security fixes. Implemented with your team, documented as we go.</p><p class="out"><strong>Produces:</strong> working controls and designs, not slideware.</p></div>
            <div class="step4"><div class="n">4</div><h3>Validate</h3><p>Test the result and assemble the evidence: assurance reviews, audit preparation, control testing. The goal is a posture that survives an auditor, a customer review — and an attacker.</p><p class="out"><strong>Produces:</strong> evidence packs and audit-ready confidence.</p></div>
          </div>
        </div>
      </section>

      <!-- EXPERTISE -->
      <section class="block" id="expertise">
        <div class="wrap">
          <div class="sec-head">
            <div class="kicker">Technical expertise</div>
            <h2>Deep where it matters</h2>
            <p>Advisory is only credible when it rests on engineering depth. AkroSecure's practice is grounded in security architecture and applied cryptography — the disciplines where small design errors become large incidents.</p>
          </div>
          <div class="expertise">
            <span class="chip"><strong>Secure architecture</strong> &amp; design review</span>
            <span class="chip"><strong>PKI</strong> — design, hierarchy, lifecycle</span>
            <span class="chip"><strong>Cryptography</strong> — applied, honestly bounded</span>
            <span class="chip"><strong>TLS / mTLS</strong> — configuration &amp; rollout</span>
            <span class="chip"><strong>Product security</strong> &amp; threat modelling</span>
            <span class="chip"><strong>EU CRA</strong> readiness</span>
            <span class="chip"><strong>ISO 27001</strong> — ISMS &amp; Annex A controls</span>
            <span class="chip"><strong>SOC 2</strong> — Trust Services Criteria</span>
            <span class="chip"><strong>NIST CSF</strong> — alignment &amp; maturity</span>
            <span class="chip"><strong>Risk assessment</strong> &amp; treatment</span>
            <span class="chip"><strong>Security policies</strong> &amp; standards</span>
            <span class="chip"><strong>Audit preparation</strong> &amp; assurance</span>
            <span class="chip"><strong>Identity</strong> &amp; access architecture</span>
            <span class="chip"><strong>Security posture</strong> assessment</span>
          </div>
        </div>
      </section>

      <!-- INSIGHTS -->
      <section class="block" id="insights">
        <div class="wrap">
          <div class="sec-head">
            <div class="kicker">Insights</div>
            <h2>Thinking we publish, not just sell</h2>
            <p>An emerging practice earns trust by showing its reasoning. Short briefings from the practice, published as they are written.</p>
          </div>
          {posts.length === 0 ? (
            <div class="note-box"><strong>No insights published yet.</strong> The first briefing will appear here when it is published.</div>
          ) : (
            <div class="insights">
              {posts.map((post) => (
                <article class="insight">
                  {post.data.tag && <div class="tagline2">{post.data.tag}</div>}
                  <h3><a href={`/insights/${post.id}/`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                  <div class="foot">
                    {post.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </div>
                </article>
              ))}
            </div>
          )}

          <p style="margin-top:18px;"><a href="/insights/" style="font-weight:700;">Browse all insights →</a></p>

          <div class="sec-head" style="margin-top:48px;">
            <h2 style="font-size:clamp(24px,3vw,32px);">Working tools, free to use</h2>
            <p>Practical templates from the practice — download them and use them in your next assessment or design review.</p>
          </div>
          <div class="resources" id="resourceGrid"></div>
        </div>
      </section>

      <!-- TRAINING -->
      <section class="block" id="training">
        <div class="wrap">
          <div class="training-band">
            <h2>Training &amp; capability development</h2>
            <p class="intro">Training is the fourth AkroSecure practice — the way capability outlives any single engagement. The catalogue is published as a preview: one course in development, <strong style="color:#fff;">Practical PKI, Certificates &amp; TLS for Engineers</strong>, with its full syllabus free to read. Nothing is on sale yet — read the course page, and register your interest to hear when enrolment opens.</p>
            <p style="margin-top:18px;"><a class="btn" href="/training/">Browse the training catalogue</a></p>
            <div class="tpaths">
              <div class="tpath"><h3>Foundation</h3><p>How systems fit together, where they break, and the vocabulary of architecture — trust boundaries, assets, controls. Ends with a first structured threat model.</p><div class="tm">In development</div></div>
              <div class="tpath"><h3>Practitioner</h3><p>Threat modelling, design reviews, cloud and identity architecture for engineers and consultants whose judgement must hold up in the room.</p><div class="tm">In development</div></div>
              <div class="tpath"><h3>Advanced</h3><p>Architecture strategy, roadmaps and governance for senior architects and security leaders setting direction across teams and suppliers.</p><div class="tm">In development</div></div>
            </div>
          </div>
        </div>
      </section>


      <!-- ABOUT -->
      <section class="block" id="about">
        <div class="wrap about-grid">
          <div class="about-copy">
            <div class="kicker mono" style="font-size:12.5px;letter-spacing:1.6px;text-transform:uppercase;color:var(--teal);">About</div>
            <h2 style="margin-top:8px;">An emerging practice, honest about it</h2>
            <p>AkroSecure is a new, independent cybersecurity advisory, engineering and assurance practice. The name joins <em>akros</em> — Greek for highest — with the standard the work is held to: <strong>security at its highest level of rigour</strong>.</p>
            <p>The practice is led by a <strong>security principal with a research doctorate and deep experience across security architecture, cryptography and assurance</strong>. It is deliberately brand-first and independent: AkroSecure has no affiliation with any employer, vendor, or certification body, and its advice is not tied to reselling anyone's products.</p>
            <p>We are at the start, and this page says so plainly. There are no client logos here, no borrowed case studies, no invented history — because trust built on claims that cannot survive a question is not trust. What is on offer is expertise, a disciplined method, and work evidenced well enough to be examined.</p>
          </div>
          <div class="principles">
            <h3>How we hold ourselves</h3>
            <ul>
              <li><strong>Evidence over assertion.</strong> Every assessment finding is traceable to something observed, tested, or documented.</li>
              <li><strong>Honest scope.</strong> Availability is labelled on every service; readiness is never dressed up as certification.</li>
              <li><strong>No guaranteed outcomes.</strong> Audits and certifications are decided by independent examiners — we prepare you properly and say so.</li>
              <li><strong>Engineering, not theatre.</strong> Controls that operate in practice outrank documents that merely exist.</li>
              <li><strong>Independence.</strong> No vendor commissions, no employer affiliation, no conflicts carried into advice.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section class="block" id="faq">
        <div class="wrap">
          <div class="sec-head">
            <div class="kicker">Questions</div>
            <h2>Answered plainly</h2>
          </div>
          <div class="faq" id="faqList">
            <div class="faq-item"><button type="button" aria-expanded="false">Does AkroSecure issue ISO 27001 certificates or SOC 2 reports?<span class="chev" aria-hidden="true">+</span></button><div class="ans"><p>No — and no readiness provider legitimately can. ISO 27001 certificates are issued by accredited certification bodies; SOC 2 reports are issued by licensed CPA firms. AkroSecure provides readiness: gap analysis, management-system and controls design, evidence preparation and audit support, so that the independent examination goes as it should.</p></div></div>
            <div class="faq-item"><button type="button" aria-expanded="false">Can you guarantee we will pass our audit or certification?<span class="chev" aria-hidden="true">+</span></button><div class="ans"><p>No. Any provider who guarantees an audit outcome is telling you something about themselves. Outcomes are decided by independent auditors on the evidence in front of them. What we commit to is honest assessment, prioritised remediation, and evidence prepared to be examined.</p></div></div>
            <div class="faq-item"><button type="button" aria-expanded="false">Which services are available now?<span class="chev" aria-hidden="true">+</span></button><div class="ans"><p>Strategy &amp; Advisory, Governance, Risk &amp; Compliance, and Product Security &amp; Engineering are accepting inquiries now. Training courses are in development — the first, Practical PKI, Certificates &amp; TLS for Engineers, is listed in the <a href="/training/">training catalogue</a>, where you can register your interest. Every service on this page is labelled with its current status.</p></div></div>
            <div class="faq-item"><button type="button" aria-expanded="false">Who is behind AkroSecure?<span class="chev" aria-hidden="true">+</span></button><div class="ans"><p>An independent practice led by a security principal with a research doctorate and experience across security architecture, PKI and cryptography, and assurance. AkroSecure is brand-first by design: engagements are with the practice, and the work is judged on its quality and evidence. AkroSecure is not affiliated with any employer.</p></div></div>
            <div class="faq-item"><button type="button" aria-expanded="false">What happens after I send an inquiry?<span class="chev" aria-hidden="true">+</span></button><div class="ans"><p>The form below emails your inquiry to AkroSecure. A consultation starts with a scoping conversation: what triggered the need, what standard or deadline applies, and whether AkroSecure is the right fit — including an honest “no” when it is not. Your inquiry is also shown on the page after you send it, so you can copy it for your records or send it via LinkedIn.</p></div></div>
          </div>
        </div>
      </section>


      <!-- CONTACT -->
      <section class="block" id="contact">
        <div class="wrap">
          <div class="contact-band">
            <div class="contact-grid">
              <div>
                <h2>Request a consultation</h2>
                <p class="intro">Tell us what triggered the conversation — a certification goal, a regulation, a customer requirement, a design problem. Fill in the form and your inquiry is emailed to AkroSecure; it is also shown below so you can copy it for your records or send it via LinkedIn.</p>
                <p class="intro" style="margin-top:14px;"><a class="btn ghost" href="https://www.linkedin.com/company/secstone" target="_blank" rel="noopener">AkroSecure on LinkedIn</a></p>
                <p class="intro" style="margin-top:10px;">Prefer email? Write to us directly at <a href="mailto:contact@akrosecure.com">contact@akrosecure.com</a>.</p>
                <p class="intro" style="margin-top:10px;font-size:14.5px;color:var(--muted);">The LinkedIn URL still shows the former name while LinkedIn's 30-day slug rule runs — the page itself is AkroSecure. Submitting the form emails your inquiry to AkroSecure; nothing you enter is stored on this page.</p>
              </div>
              <form class="inquiry" id="inquiryForm">
                <label>Your name
                  <input type="text" id="inqName" required placeholder="e.g. Alex Morgan" />
                </label>
                <label>Organisation
                  <input type="text" id="inqOrg" placeholder="Company or team (optional)" />
                </label>
                <label>Your email
                  <input type="email" id="inqEmail" required placeholder="you@example.com" />
                </label>
                <label>I would like to discuss
                  <select id="inqTopic">
                    <option>Security posture assessment / roadmap</option>
                    <option>ISO 27001 readiness</option>
                    <option>SOC 2 readiness</option>
                    <option>NIST CSF alignment</option>
                    <option>EU CRA readiness</option>
                    <option>Secure architecture / design review</option>
                    <option>PKI, cryptography or TLS/mTLS</option>
                    <option>Training &amp; capability development</option>
                    <option>Something else</option>
                  </select>
                </label>
                <label>Brief context
                  <textarea id="inqContext" placeholder="Deadline, standard, product, or problem — a few lines is enough."></textarea>
                </label>
                <label class="hp" aria-hidden="true">Website
                  <input type="text" id="inqWebsite" name="website" tabindex="-1" autocomplete="off" />
                </label>
                <button class="btn" type="submit">Send my inquiry</button>
                <div class="inq-status" id="inqStatus" role="status"></div>
                <div class="inq-output" id="inqOutput">
                  <label style="font-weight:600;font-size:15.5px;display:grid;gap:6px;">Your inquiry — also shown here so you can copy it for your records or send it via LinkedIn:
                    <textarea id="inqText" readonly></textarea>
                  </label>
                  <div class="row">
                    <button type="button" class="link-btn" id="inqCopy">Copy inquiry</button>
                    <span class="copied" id="inqCopied" role="status"></span>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>
        </main>
  <script>
    import { renderHomeResources } from '../scripts/resources.js';
    import '../scripts/faq.js';
    import '../scripts/contact.js';
    renderHomeResources();
  </script>
</BaseLayout>
